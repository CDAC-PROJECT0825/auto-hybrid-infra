pipeline {
    agent none

    environment {
        IMAGE_NAME = "deoatharva4/python_app"
        IMAGE_TAG  = "latest"
        SONAR_HOST = "http://127.0.0.1:9000"
    }

    stages {

        stage('Checkout Code') {
            agent any
            steps {
                git branch: 'main',
                    url: 'https://github.com/CDAC-PROJECT0825/auto-hybrid-infra.git'
            }
        }

        stage('SonarQube Analysis') {
            agent { label 'Stage-Agent' }
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }
            steps {
                sh """
                sonar-scanner \
                  -Dsonar.projectKey=DevinfraX \
                  -Dsonar.sources=. \
                  -Dsonar.host.url=${SONAR_HOST} \
                  -Dsonar.login=${SONAR_TOKEN}
                """
            }
        }

        stage('Build Docker Image') {
            agent any
            steps {
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Push Image to Docker Hub') {
            agent any
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASS'
                    )
                ]) {
                    sh """
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to Stage') {
            agent { label 'Stage-Agent' }
            steps {
                sh """
                docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                docker rm -f stage-app || true
                docker run -d --name stage-app -p 5001:5000 ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to PreProd') {
            agent { label 'Preprod-Agent' }
            steps {
                sh """
                docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                docker rm -f preprod-app || true
                docker run -d --name preprod-app -p 5002:5000 ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to Prod') {
            agent { label 'Prod-Agent' }
            steps {
                sh """
                docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                docker rm -f prod-app || true
                docker run -d --name prod-app -p 80:5000 ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "✅ CI/CD Pipeline executed successfully across Stage, PreProd, and Prod"
        }
        failure {
            echo "❌ Pipeline failed — check logs"
        }
    }
}
