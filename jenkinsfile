                sh """
                docker rm -f stage-app || true
                docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true
                docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                docker run -d --name stage-app -p 5001:5000 ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to PreProd') {
