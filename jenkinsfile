pipeline {
    agent none

    environment {
        IMAGE_NAME = "deoatharva4/python_app"
        IMAGE_TAG  = "latest"
    }

    stages {

        stage('Checkout Code') {
            agent any
            steps {
                git branch: 'main',
                    url: 'https://github.com/CDAC-PROJECT0825/auto-hybrid-infra.git'
            }
        }

        /* 🚫 Docker Hub delete DISABLED (API no longer supports JWT) */
        stage('Delete Image on Docker Hub') {
            agent any
            steps {
                echo "Skipping Docker Hub delete – tag overwrite is sufficient"
            }
        }

        stage('Build Docker Image') {
            agent any
            steps {
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Push Image to Docker Hub') {
            agent any
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker push deoatharva4/python_app:latest
                    '''
                }
            }
        }

        stage('Deploy to Stage') {
<<<<<<< HEAD
            agent { label 'Stage-Agent' }
=======
            agent { label 'stage-agent' }
